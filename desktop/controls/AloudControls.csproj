<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A tiny helper that gives Aloud a presence in Windows' media controls: the volume flyout,
    the keyboard's media keys, and Bluetooth headset buttons. It targets .NET Framework 4.8,
    which every Windows 10 and 11 machine already has, so it adds no runtime to install.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AloudControls</AssemblyName>
    <RootNamespace>AloudControls</RootNamespace>
    <AssemblyTitle>Aloud</AssemblyTitle>
    <Product>Aloud</Product>
    <Company>Aloud</Company>
    <Description>Aloud</Description>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.1" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
